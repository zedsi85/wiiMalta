# Public site origin used for canonical / Open Graph URLs.
# On Vercel this falls back to VERCEL_URL automatically; set this to pin a
# custom production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://wiieventmalta.com

# ── Ticketing ──
# mock (local dev, /api/dev/mock-pay simulates the webhook) | revolut
PAYMENT_PROVIDER=mock
# HMAC secrets — generate long random strings; rotate = invalidate all QRs/links
QR_SIGNING_SECRET=
ORDER_LINK_SECRET=
# Revolut Merchant API (sandbox-merchant.revolut.com until go-live)
REVOLUT_API_BASE=https://sandbox-merchant.revolut.com
REVOLUT_SECRET_KEY=
REVOLUT_WEBHOOK_SECRET=
NEXT_PUBLIC_REVOLUT_MODE=sandbox
