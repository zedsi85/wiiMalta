{
  "name": "wii-malta",
  "version": "0.1.0",
  "private": true,
  "description": "Wii Malta \u2014 Event OS monorepo. Marketing site + platform (apps) and shared domain/design packages.",
  "packageManager": "npm@10.7.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "apps/web",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wii/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "sharp": "^0.35.3"
  }
}
